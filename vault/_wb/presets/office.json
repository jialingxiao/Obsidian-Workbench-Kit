{
  "name": { "zh": "工作台", "en": "Work Desk" },
  "desc": { "zh": "以「今天要收尾什么」为中心：临期、待办、按状态分列、产出趋势", "en": "Built around what ships today: due dates, tasks, status board and throughput" },
  "theme": "曜石",
  "blocks": [
    { "c": "clock", "x": 0, "y": 0, "w": 3, "h": 4,
      "props": { "showSeconds": false, "showDate": true, "align": "center" } },

    { "c": "greeting", "x": 3, "y": 0, "w": 6, "h": 4,
      "props": { "subtitle": "先看临期，再看在做的", "align": "left" } },

    { "c": "year-progress", "x": 9, "y": 0, "w": 3, "h": 4,
      "props": { "label": "本周", "unit": "week", "style": "dots" } },

    { "c": "quick-actions", "x": 0, "y": 4, "w": 12, "h": 4,
      "props": { "style": "tile", "items": [
        { "label": "记一笔",   "icon": "✏️", "folder": "@inbox" },
        { "label": "搜索",     "icon": "🔍", "command": "global-search:open" },
        { "label": "命令面板", "icon": "⌘",  "command": "command-palette:open" },
        { "label": "今日日记", "icon": "📅", "command": "daily-notes" }
      ] } },

    { "c": "upcoming", "x": 0, "y": 8, "w": 5, "h": 9,
      "props": { "label": "临期与逾期", "days": 14, "showOverdue": true, "limit": 10 } },

    { "c": "tasks", "x": 5, "y": 8, "w": 7, "h": 9,
      "props": { "label": "待办", "limit": 12, "groupByFile": true } },

    { "c": "kanban", "x": 0, "y": 17, "w": 12, "h": 8,
      "props": { "label": "按状态", "field": "status", "limit": 5,
                 "columns": ["待办", "进行中", "待审", "已完成"] } },

    { "c": "trend", "x": 0, "y": 25, "w": 7, "h": 6,
      "props": { "label": "近 12 周产出", "unit": "week", "periods": 12 } },

    { "c": "breakdown", "x": 7, "y": 25, "w": 5, "h": 6,
      "props": { "label": "各区占比", "showPercent": true } }
  ]
}

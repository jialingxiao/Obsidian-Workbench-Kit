{
  "name": { "zh": "日程计划", "en": "Planner" },
  "desc": { "zh": "时钟 + 日记 + 月历 + 到期待办，以「今天」为中心", "en": "Clock, daily note, calendar and due tasks — built around today" },
  "theme": "素笺",
  "blocks": [
    { "c": "clock", "x": 0, "y": 0, "w": 3, "h": 4, "props": { "showSeconds": false } },

    { "c": "greeting", "x": 3, "y": 0, "w": 9, "h": 4,
      "props": { "subtitle": "先看看今天要做什么" } },

    { "c": "daily",    "x": 0, "y": 4, "w": 4, "h": 6, "props": { "label": "日记", "days": 14 } },
    { "c": "calendar", "x": 4, "y": 4, "w": 4, "h": 9, "props": {} },
    { "c": "streak",   "x": 8, "y": 4, "w": 4, "h": 4, "props": { "label": "连续记录" } },

    { "c": "upcoming", "x": 8, "y": 8,  "w": 4, "h": 7,
      "props": { "label": "即将到期", "days": 14 } },

    { "c": "tasks",    "x": 0, "y": 10, "w": 4, "h": 8,
      "props": { "label": "待办", "limit": 10 } },

    { "c": "heatmap",  "x": 0, "y": 18, "w": 12, "h": 5,
      "props": { "label": "活动记录", "weeks": 52 } }
  ]
}

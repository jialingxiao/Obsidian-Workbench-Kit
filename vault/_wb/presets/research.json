    { "c": "coverage", "x": 5, "y": 24, "w": 7, "h": 7,
      "props": { "label": "字段体检", "source": "@notes", "field": "一句话描述,status,project", "showMiss": 5 } },

    { "c": "stale", "x": 0, "y": 31, "w": 6, "h": 7,
      "props": { "label": "久未回顾", "limit": 6 } },

    { "c": "vault-info", "x": 6, "y": 31, "w": 6, "h": 7,
      "props": { "label": "库总览", "showWords": true, "showOldest": true } }
  ]

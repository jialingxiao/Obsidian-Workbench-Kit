{
  "name": { "zh": "研究台", "en": "Research Desk" },
  "desc": { "zh": "关系图 + 枢纽 / 孤岛 + 字段体检，盯的是「知识网结不结实」", "en": "Graph, hubs and orphans, field coverage — is the network actually connected?" },
  "theme": "水墨",
  "blocks": [
    { "c": "masthead", "x": 0, "y": 0, "w": 12, "h": 6,
      "props": { "subtitle": "Research Desk", "kicker": "读 · 想 · 记", "inverted": false, "edition": false } },

    { "c": "graph", "x": 0, "y": 6, "w": 7, "h": 9,
      "props": { "label": "关系图", "nodes": 14, "showLabels": true } },

    { "c": "hubs", "x": 7, "y": 6, "w": 5, "h": 9,
      "props": { "label": "枢纽笔记", "limit": 8, "style": "bars" } },

    { "c": "timeline", "x": 0, "y": 15, "w": 7, "h": 9,
      "props": { "label": "研究时间线", "source": "@notes", "limit": 10,
